# Copy this to `.env` on the VPS and fill in real values.
# Do NOT commit the real .env — it's gitignored.

# REQUIRED — single-user password to access the dashboard.
# Generate one with: openssl rand -base64 24
AGENTIC_OS_PASSWORD=change-me-please

# Optional — separate signing secret for session cookies. Defaults to the password.
# Generate one with: openssl rand -hex 32
# AGENTIC_OS_SECRET=

# Vault root inside the container. Defaults to a persistent Docker volume.
# To point at a host folder instead, also add a `- /host/path:/host/vault`
# mount under volumes: in compose.yml and set:
# AGENTIC_OS_VAULT=/host/vault

# Where the VPS Hermes lives. Leave default unless you change the routing.
# AGENTIC_OS_HERMES_URL=https://hermes-agent-gn0b.srv1344233.hstgr.cloud
